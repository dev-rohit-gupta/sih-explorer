# Official source can be changed later without touching code.
SIH_PS_URL=https://sih.gov.in/sih2026PS

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres compatible).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Protects /api/cron/sync. Vercel Cron sends this as Bearer token when configured as CRON_SECRET.
CRON_SECRET=replace-with-a-long-random-secret

# Reliability controls.
SIH_SYNC_STALE_MINUTES=15
SIH_FETCH_TIMEOUT_MS=10000
SIH_MIN_PS_COUNT=50
SIH_SNAPSHOT_RETENTION=20
